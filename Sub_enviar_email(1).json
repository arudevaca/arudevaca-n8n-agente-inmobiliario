      "parameters": {
        "jsCode": "const data = $input.first().json;\nconsole.log('DATA RECIBIDA:', JSON.stringify(data));\n\nconst email = data.email || data.body?.email || '';\nconst nombre = data.nombre || data.body?.nombre || 'Cliente';\nconst fecha_hora = data.fecha_hora || data.body?.fecha_hora || '';\nconst tipo_cita = data.tipo_cita || data.body?.tipo_cita || '';\nconst telefono = data.Telefono || data.body?.Telefono || '';\n\n// Formatear fecha de ISO a dd/mm/aa HH:MM\nlet fechaFormateada = fecha_hora;\nif (fecha_hora.includes('T')) {\n  const [datePart, timePart] = fecha_hora.split('T');\n  const [year, month, day] = datePart.split('-');\n  const [hour, minute] = timePart.split(':');\n  fechaFormateada = `${day}/${month}/${year.slice(2)} ${hour}:${minute}`;\n}\n\n// Bloque de ubicación según tipo de cita\nlet ubicacionInfo = '';\nconst tipoCitaLower = tipo_cita.toLowerCase();\n\nif (tipoCitaLower.includes('oficina')) {\n  ubicacionInfo = `📌 Lugar: EDEN2E\\n🗺️ Ubicación Oficina: https://maps.app.goo.gl/hgjg5mVDR9SUAWqy6`;\n} else if (tipoCitaLower.includes('desarrollo')) {\n  ubicacionInfo = `📌 Lugar: Nuevo Paraíso\\n🗺️ Ubicación Desarrollo: https://maps.app.goo.gl/dRasW9ahYeMxxQyu6`;\n} else {\n  ubicacionInfo = `📌 Tipo: ${tipo_cita}`;\n}\n\nreturn [{\n  json: {\n    to: email,\n    subject: 'Confirmación de cita ED3N2E',\n    body: `Hola ${nombre},\\n\\nTu cita ha sido confirmada exitosamente. 🎉\\n\\nDetalles:\\n📅 Fecha y hora: ${fechaFormateada}\\n${ubicacionInfo}\\n\\nCualquier duda estamos para ayudarte.\\n\\n¡Te esperamos!\\nEquipo ED3N2E`,\n    telefono: telefono,\n    email: email,\n    nombre: nombre,\n    tipo_cita: tipo_cita\n  }\n}];"
      },
